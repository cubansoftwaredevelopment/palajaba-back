MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=ecommerce
SECRET_KEY=change-this-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Orígenes permitidos para CORS (separados por coma, sin barra final).
# En Render: configurar en Environment del servicio backend, NO en .env.production local.
# Ejemplo producción:
# CORS_ORIGINS=https://palajaba-web.onrender.com,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cloudinary (https://console.cloudinary.com → Account Details → Cloud name)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
